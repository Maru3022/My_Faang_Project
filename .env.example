# Local development only. Copy to .env; do not commit secrets.
DATABASE_PASSWORD=local-dev-only
# Replace with your managed identity provider's issuer and JWKS endpoint.
OIDC_ISSUER_URI=https://identity.example.test
OIDC_JWK_SET_URI=https://identity.example.test/.well-known/jwks.json
OIDC_AUDIENCE=devpath-api
